{
  "name": "functions",
  "private": true,
  "description": "Servidor de la plataforma: checkout, Mercado Pago, pedidos, stock y avisos.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@plataforma/core": "*",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
