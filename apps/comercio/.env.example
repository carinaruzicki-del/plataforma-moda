# Copiá a .env y completá con la app web de tu proyecto de Firebase.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=plataforma-moda-dev
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Dominio de la plataforma, para mostrar el link de la tienda.
EXPO_PUBLIC_PLATFORM_DOMAIN=localhost:3000
# 1 = usar los emuladores locales. En el celular, poné la IP de tu compu en EXPO_PUBLIC_EMULATOR_HOST.
EXPO_PUBLIC_USE_EMULATORS=1
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
