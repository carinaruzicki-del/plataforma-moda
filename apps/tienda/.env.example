# Copiá este archivo a .env.local y completá con los datos de tu proyecto de Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → App web).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=plataforma-moda-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Dominio de la plataforma. Cada tienda vive en <subdominio>.<dominio>.
# En desarrollo se usa localhost:3000 y la tienda va en la ruta: http://localhost:3000/t/<subdominio>
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost:3000

# 1 = usar los emuladores locales de Firebase (npm run emulators en la raíz).
NEXT_PUBLIC_USE_EMULATORS=1

# 1 = usar el checkout de prueba de Mercado Pago (credenciales de test).
NEXT_PUBLIC_MP_SANDBOX=1
